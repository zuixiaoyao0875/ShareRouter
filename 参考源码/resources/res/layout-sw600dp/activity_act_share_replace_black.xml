<?xml version="1.0" encoding="utf-8"?>
<com.sothree.slidinguppanel.SlidingUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sothree="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:id="@+id/sliding_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    sothree:umanoDragView="@+id/drag_view"
    sothree:umanoFadeColor="@android:color/transparent"
    sothree:umanoOverlay="true"
    sothree:umanoPanelHeight="320dp"
    sothree:umanoParallaxOffset="0dp"
    sothree:umanoScrollableView="@+id/dialog_list"
    sothree:umanoShadowHeight="0dp">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/drag_view"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:theme="@style/ShareReplaceBlack"
            android:orientation="vertical"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:elevation="8dp">
            <RelativeLayout
                android:id="@+id/dialog_topbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:elevation="0dp">
                <TextView
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:id="@+id/dialog_title"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="通过共享"
                    android:singleLine="true"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <ImageButton
                    android:id="@+id/dialog_icon_more_vert"
                    android:background="@android:color/transparent"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="4dp"
                    android:foreground="@drawable/ripple_primary"
                    android:scaleType="center"
                    android:adjustViewBounds="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    sothree:srcCompat="@drawable/baseline_more_vert_24"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_list_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/no_results"
                    android:background="@android:color/transparent"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="120dp"
                    android:layout_marginRight="16dp"
                    android:text="未找到共享目标"
                    android:singleLine="true"
                    android:layout_centerVertical="true"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dialog_list"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="32dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:layout_weight="1"
                    android:headerDividersEnabled="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.sothree.slidinguppanel.SlidingUpPanelLayout>
